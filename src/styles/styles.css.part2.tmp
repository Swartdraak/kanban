/* Kanban Task Board — styles (part 2 of 2) */
.task-card__controls {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-3) var(--space-3);
  align-items: center;
}

.task-card__move {
  flex: 1;
  min-width: 120px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text);
  border-radius: var(--radius-sm);
  padding: 5px 8px;
  font-size: 0.8rem;
}

.task-card__action {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
  border-radius: var(--radius-sm);
  padding: 5px 10px;
  font-size: 0.8rem;
  cursor: pointer;
  transition:
    background 120ms ease,
    color 120ms ease,
    border-color 120ms ease;
}

.task-card__action:hover {
  background: var(--color-surface);
  color: var(--color-text);
}

.task-card__action:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 1px;
}

.task-card__action--delete {
  margin-left: auto;
}

.task-card__action--delete:hover {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.task-card__action--complete[aria-pressed='true'] {
  background: rgba(46, 204, 113, 0.12);
  border-color: var(--color-success);
  color: var(--color-success);
}

/* Priority badge */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  border: 1px solid transparent;
}

.badge--low {
  background: rgba(90, 159, 110, 0.16);
  color: var(--priority-low);
  border-color: rgba(90, 159, 110, 0.35);
}
.badge--medium {
  background: rgba(224, 168, 58, 0.16);
  color: var(--priority-medium);
  border-color: rgba(224, 168, 58, 0.35);
}
.badge--high {
  background: rgba(224, 102, 58, 0.16);
  color: var(--priority-high);
  border-color: rgba(224, 102, 58, 0.35);
}
.badge--urgent {
  background: rgba(214, 69, 96, 0.18);
  color: var(--priority-urgent);
  border-color: rgba(214, 69, 96, 0.4);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border-radius: var(--radius-sm);
  padding: 8px 14px;
  font-size: 0.88rem;
  font-weight: 500;
  border: 1px solid transparent;
  cursor: pointer;
  transition:
    background 120ms ease,
    border-color 120ms ease,
    transform 80ms ease;
}

.btn:active {
  transform: translateY(1px);
}

.btn:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.btn--primary {
  background: var(--color-accent-strong);
  color: #fff;
}
.btn--primary:hover {
  background: var(--color-accent);
}

.btn--secondary {
  background: transparent;
  border-color: var(--color-border);
  color: var(--color-text-muted);
}
.btn--secondary:hover {
  border-color: #3a4255;
  color: var(--color-text);
}

.btn--ghost {
  background: transparent;
  color: var(--color-text-muted);
}
.btn--ghost:hover {
  color: var(--color-text);
}

/* Task modal */
.task-modal {
  /* Native <dialog> backdrop styles */
  background: transparent;
  border: none;
  padding: 0;
  max-width: 100%;
  overflow: hidden;
}

.task-modal::backdrop {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(2px);
}

/* The dialog element itself holds the content; we restyle the inner wrapper
   because some browsers give <dialog> a default 215px width. */
.task-modal {
  width: min(540px, calc(100vw - 32px));
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-modal);
  color: var(--color-text);
  margin: auto;
  padding: var(--space-5);
}

.task-modal__title {
  font-size: 1.15rem;
  font-weight: 600;
  margin-bottom: var(--space-4);
}

.task-modal__form {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.task-modal__field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.task-modal__label {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  font-weight: 500;
}

.task-modal__field input,
.task-modal__field select,
.task-modal__field textarea {
  background: var(--color-surface-alt);
  border: 1px solid var(--color-border);
  color: var(--color-text);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
  font-size: 0.9rem;
  width: 100%;
}

.task-modal__field input:focus-visible,
.task-modal__field select:focus-visible,
.task-modal__field textarea:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 1px;
  border-color: transparent;
}

.task-modal__field textarea {
  resize: vertical;
  min-height: 80px;
}

.task-modal__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

/* Responsive polish */
@media (max-width: 480px) {
  .board__header {
    padding: var(--space-4) var(--space-3) var(--space-3);
  }

  .board__columns {
    padding: 0 var(--space-3) var(--space-5);
    gap: var(--space-3);
  }

  .board__column {
    max-height: none;
  }

  .task-modal {
    padding: var(--space-4);
  }
}

/* Reduced motion: respect user preference */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
